APP_PORT=8080
APP_ENV=development            # 'development' atau 'production' (production -> Gin release mode)
# APP_URL wajib diisi di production. Dipakai untuk membangun tautan paginasi.
# Bila kosong, base URL diambil dari header Host yang dikirim klien sehingga
# tautan di response bisa diarahkan ke domain penyerang.
APP_URL=

# Log terstruktur (docs/TECHNICAL-BACKEND.md §15)
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json               # 'json' (produksi) atau 'text' (dev, lebih enak dibaca)

# Timeout HTTP server (detik) — mencegah koneksi lambat menahan resource (Slowloris)
SERVER_READ_HEADER_TIMEOUT_SECONDS=10
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_MAX_HEADER_BYTES=1048576

# Database
# DB_USER WAJIB role NON-SUPERUSER: RLS (FORCE ROW LEVEL SECURITY) tidak berlaku
# untuk superuser — konek sebagai 'postgres' mematikan isolasi antar-tenant.
# Lihat deploy/postgres-init.sql.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable            # gunakan 'require' atau 'verify-full' di production
DB_TZ=UTC                     # WAJIB UTC — semua waktu disimpan UTC (§3.2). Jangan diubah ke Asia/Jakarta.
DB_MAX_OPEN_CONNS=25          # total koneksi maksimum ke PostgreSQL
DB_MAX_IDLE_CONNS=25          # koneksi idle yang dipertahankan (<= MAX_OPEN, agar dipakai ulang)
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_CONN_MAX_IDLE_MINUTES=5    # lepas koneksi menganggur agar session tidak menumpuk
DB_STATEMENT_TIMEOUT_MS=30000 # PostgreSQL membatalkan query yang lewat batas ini (0 = nonaktif)
DB_PREPARE_STMT=true          # cache prepared statement; set 'false' bila pakai PgBouncer

# JWT — WAJIB diisi, minimal 32 karakter. Generate dengan: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_MINUTES=15         # umur access token (pendek — dicabut lewat kedaluwarsa)
JWT_REFRESH_DAYS=30           # umur refresh token (panjang — dicabut lewat tabel refresh_tokens)

# Zona waktu default untuk OUTLET baru saja (bukan zona server). Nama IANA:
# Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT).
DEFAULT_TIMEZONE=Asia/Jakarta

# Keamanan
BCRYPT_COST=10               # 10-12 disarankan
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# TRUSTED_PROXIES=127.0.0.1  # isi bila di belakang reverse proxy (Nginx/Caddy)

# Rate limit endpoint auth (/api/v1/auth/*), per IP, token-bucket.
AUTH_RATELIMIT_RPS=0.2        # token diisi ulang per detik (laju berkelanjutan)
AUTH_RATELIMIT_BURST=5        # permintaan beruntun maksimum

# Backend pembatas laju. Kosong = memori (per-instance; batas jadi N× dengan N
# replika). Diisi = Redis (penegakan lintas-instance). Bila diisi tapi Redis
# tak terjangkau saat START → aplikasi fatal; bila blip saat runtime → fail-open.
RATELIMIT_REDIS_URL=          # mis. redis://localhost:6379/0

# Rate limit webhook kanal (POST /webhooks/channels/:provider, tanpa auth),
# per IP. Longgar — kanal wajar membebankan puluhan pesanan/detik saat sibuk.
CHANNEL_WEBHOOK_RATELIMIT_RPS=20
CHANNEL_WEBHOOK_RATELIMIT_BURST=40

# Portal mitra (Fase 12). Umur access token realm "partner" — lebih panjang dari
# token tenant; portal dipakai lebih jarang & belum punya alur refresh.
PARTNER_JWT_ACCESS_MINUTES=120

# Idempotensi (§8): berapa lama hasil operasi yang menciptakan uang/stok
# (checkout dll) disimpan untuk replay permintaan yang sama.
IDEMPOTENCY_TTL_DAYS=7

# Sinkronisasi offline (§10). Ukuran halaman GET /api/v1/sync/pull.
SYNC_PULL_DEFAULT_LIMIT=500    # dipakai bila klien tak mengirim ?limit=
SYNC_PULL_MAX_LIMIT=1000       # batas atas ?limit=
SYNC_CURSOR_SAFETY_LAG=1000    # saran jeda aman: klien menyimpan (cursor - ini)

# Langganan platform (§5.13). Lama trial & tenggat pembayaran tagihan.
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_INVOICE_DUE_DAYS=7
