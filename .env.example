APP_PORT=8080
APP_ENV=development            # 'development' atau 'production' (production -> Gin release mode)
# APP_URL wajib diisi di production. Dipakai untuk membangun tautan paginasi.
# Bila kosong, base URL diambil dari header Host yang dikirim klien sehingga
# tautan di response bisa diarahkan ke domain penyerang.
APP_URL=

# Log terstruktur (docs/TECHNICAL-BACKEND.md §15)
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json               # 'json' (produksi) atau 'text' (dev, lebih enak dibaca)

# Timeout HTTP server (detik) — mencegah koneksi lambat menahan resource (Slowloris)
SERVER_READ_HEADER_TIMEOUT_SECONDS=10
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_MAX_HEADER_BYTES=1048576

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable            # gunakan 'require' atau 'verify-full' di production
DB_TZ=UTC                     # WAJIB UTC — semua waktu disimpan UTC (§3.2). Jangan diubah ke Asia/Jakarta.
DB_MAX_OPEN_CONNS=25          # total koneksi maksimum ke PostgreSQL
DB_MAX_IDLE_CONNS=25          # koneksi idle yang dipertahankan (<= MAX_OPEN, agar dipakai ulang)
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_CONN_MAX_IDLE_MINUTES=5    # lepas koneksi menganggur agar session tidak menumpuk
DB_STATEMENT_TIMEOUT_MS=30000 # PostgreSQL membatalkan query yang lewat batas ini (0 = nonaktif)
DB_PREPARE_STMT=true          # cache prepared statement; set 'false' bila pakai PgBouncer

# JWT — WAJIB diisi, minimal 32 karakter. Generate dengan: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_MINUTES=15         # umur access token (pendek — dicabut lewat kedaluwarsa)
JWT_REFRESH_DAYS=30           # umur refresh token (panjang — dicabut lewat tabel refresh_tokens)

# Zona waktu default untuk OUTLET baru saja (bukan zona server). Nama IANA:
# Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT).
DEFAULT_TIMEZONE=Asia/Jakarta

# Keamanan
BCRYPT_COST=10               # 10-12 disarankan
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# TRUSTED_PROXIES=127.0.0.1  # isi bila di belakang reverse proxy (Nginx/Caddy)
